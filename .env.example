# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control

# ── Application environment ─────────────────────────────────────────────────
# Controls whether real external API calls (Gemini) are made.
#
#   dev | test  →  Lorem Ipsum 반환, API 미호출 (기본값)
#   production  →  실제 Gemini API 호출, 비용 발생
#
# 개발·테스트 중에는 dev 또는 test 를 사용하세요.
# 실제 블로그 포스팅 시에만 production 으로 변경하세요.
ENV=dev

# ── Credentials ─────────────────────────────────────────────────────────────
NAVER_ID=your_naver_id
NAVER_PW=your_naver_password
NAVER_BLOG_ID=your_blog_id
SESSION_PATH=session_state.json

# ── Localization ─────────────────────────────────────────────────────────────
LOCALE=ko_KR
TIMEZONE=Asia/Seoul
LANGUAGE=ko

# Format: latitude,longitude  (e.g. Seoul → 37.5665,126.9780)
GEOLOCATION=37.5665,126.9780
TIMEZONE_OFFSET_HOURS=9

# Leave blank to use Playwright's default Chromium user-agent
USER_AGENT=

# ── Kakao API ────────────────────────────────────────────────────────────────
# 지역 시딩 시 GPS 좌표 자동 조회에 사용.
# https://developers.kakao.com → 내 애플리케이션 → REST API 키
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# ── Gemini API ───────────────────────────────────────────────────────────────
# Required only when ENV=production.
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Gemini model alias (gemini-flash-latest = 항상 최신 Flash)
# 특정 버전 고정 시: gemini-2.5-flash, gemini-2.0-flash 등
GEMINI_MODEL=gemini-flash-latest
