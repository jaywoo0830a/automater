# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control

# ── Application environment ─────────────────────────────────────────
# dev | test  →  Lorem Ipsum, API not called (default)
# production  →  Real Gemini API call
ENV=dev

# ── Naver credentials (E2E test) ────────────────────────────────────
NAVER_ID=your_naver_id
NAVER_PW=your_naver_password
NAVER_BLOG_ID=your_blog_id
SESSION_PATH=session_state.json

# ── Gemini API ──────────────────────────────────────────────────────
# Required only when ENV=production
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
#
# 사용 가능한 모델 (출처: https://ai.google.dev/gemini-api/docs/models)
# 가격 단위: USD / 1M 토큰 (입력 / 출력)
# ──────────────────────────────────────────────────────────────────
# 안정판 (stable — 변경 시 사전 통지 보장)
#   gemini-2.5-flash-lite       $0.10 / $0.40                    ← 가장 저렴, 기본값
#   gemini-2.5-flash            $0.30 / $2.50                    품질 우선
#   gemini-2.5-pro              $1.25 / $10.00 (≤200k)           최고 품질
#                               $2.50 / $15.00 (>200k)
#
# 프리뷰 (preview — 2주 deprecation 통지 후 단종 가능)
#   gemini-3.1-flash-lite-preview  $0.25 / $1.50                 3.x 시리즈 최저가
#   gemini-3-flash-preview         $0.50 / $3.00
#   gemini-3.1-pro-preview         $2.00 / $12.00 (≤200k)
#                                  $4.00 / $18.00 (>200k)
#
# 주의: -latest 태그(예: gemini-flash-latest)는 자동 업그레이드되어
#       가격/동작이 예고 없이 바뀔 수 있으니 비추천.
#
GEMINI_MODEL=gemini-2.5-flash-lite

# ── Together AI (이미지 레이어용) ───────────────────────────────────
# featured_image / image 의 `layers:` 에 type=ai 를 쓸 때 사용된다.
# 설정되어 있으면 Together AI (FLUX.1-schnell-Free 기본) 사용,
# 비어 있으면 Pollinations.ai (무료, 키 불필요) 자동 폴백.
# https://api.together.ai
TOGETHER_API_KEY=

# ── Web / API server ────────────────────────────────────────────────
# API key for web dashboard authentication
API_KEY=your_api_key

# Domain for HTTPS (prod only, Caddy auto-cert)
DOMAIN=yourdomain.com
