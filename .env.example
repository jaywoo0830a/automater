# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control

# ── Application environment ──────────────────────────────────────────────────
# dev | test  →  Lorem Ipsum 반환, API 미호출 (기본값)
# production  →  실제 Gemini API 호출, 비용 발생
ENV=dev

# ── Naver credentials ────────────────────────────────────────────────────────
NAVER_ID=your_naver_id
NAVER_PW=your_naver_password
NAVER_BLOG_ID=your_blog_id
SESSION_PATH=session_state.json

# ── Localization ─────────────────────────────────────────────────────────────
LOCALE=ko_KR
TIMEZONE=Asia/Seoul
LANGUAGE=ko
GEOLOCATION=37.5665,126.9780
TIMEZONE_OFFSET_HOURS=9
USER_AGENT=

# ── Kakao API ────────────────────────────────────────────────────────────────
# https://developers.kakao.com → 내 애플리케이션 → REST API 키
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# ── Gemini API ───────────────────────────────────────────────────────────────
# Required only when ENV=production.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest

# ── Production DB (docker-compose) ───────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=automator
MYSQL_USER=automator
MYSQL_PASSWORD=automatorpass

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=automator
DB_USER=automator
DB_PASSWORD=automatorpass

# ── Test DB (factory 단위 테스트용 일회용 MySQL 컨테이너) ─────────────────────
# bash ./run/test.sh --factory 실행 시 이 값으로 컨테이너를 자동 기동한다.
# 포트는 운영 DB(3306) 와 겹치지 않도록 13306 을 사용한다.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=13306
TEST_DB_NAME=automator_test
TEST_DB_USER=test
TEST_DB_PASSWORD=test
