# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control

# ── Credentials ────────────────────────────────────────────────────────────
NAVER_ID=your_naver_id
NAVER_PW=your_naver_password
SESSION_PATH=session_state.json

# ── Localization ────────────────────────────────────────────────────────────
# LOCALE controls date/number formatting  (e.g. ko_KR, en_US, ja_JP, zh_CN)
LOCALE=ko_KR

# TIMEZONE is used for scheduling and timestamp display
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Asia/Seoul

# LANGUAGE sets the Accept-Language header sent to Naver
# Affects UI language returned by the server  (ko, en, ja, zh-CN, zh-TW)
LANGUAGE=ko

# GEOLOCATION simulates a physical location for the browser context
# Useful for testing region-specific content or ad targeting
# Format: latitude,longitude
# Examples:
#   Seoul, KR  → 37.5665,126.9780
#   Tokyo, JP  → 35.6762,139.6503
#   New York   → 40.7128,-74.0060
#   London     → 51.5074,-0.1278
GEOLOCATION=37.5665,126.9780

# TIMEZONE_OFFSET_HOURS is the UTC offset used when composing post timestamps
# Korea Standard Time = 9, Japan = 9, US Eastern = -5, US Pacific = -8
TIMEZONE_OFFSET_HOURS=9

# USER_AGENT overrides the browser's default user-agent string
# Leave blank to use Playwright's default Chromium user-agent
# Example (Korean Chrome on Windows):
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
USER_AGENT=
